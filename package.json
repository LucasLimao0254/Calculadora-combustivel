{
  "name": "calculadora-combustivel",
  "version": "1.0.0",
  "private": true,
  "description": "Calculadora de reajuste de preços de combustível: custo, lucro e margem por litro, com histórico e gráfico.",
  "scripts": {
    "build": "node scripts/build.js",
    "build:real": "node scripts/build.js --dados dados-reais",
    "check": "node scripts/build.js --check",
    "test": "node tests/verificar_calculos.js && node scripts/build.js --check",
    "icones": "node scripts/gerar-icones.js",
    "android:doctor": "cd android && npx --yes @bubblewrap/cli@1.27.0 doctor",
    "android:update": "cd android && npx --yes @bubblewrap/cli@1.27.0 update --skipVersionUpgrade",
    "android:build": "cd android && npx --yes @bubblewrap/cli@1.27.0 build",
    "android:assetlinks": "cd android && npx --yes @bubblewrap/cli@1.27.0 fingerprint generateAssetLinks --output=assetlinks.json"
  }
}
